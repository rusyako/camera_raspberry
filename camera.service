[Unit]
Description=Camera Surveillance App
After=network-online.target local-fs.target usb.target
Wants=network-online.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/admin/camera_raspberry
Environment=RECORDINGS_DIR=/home/admin/camera_raspberry/recordings_internal
ExecStart=/usr/bin/python3 -m src.main
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
User=admin

[Install]
WantedBy=multi-user.target
